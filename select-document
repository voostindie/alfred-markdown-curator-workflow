#!/bin/zsh --no-rcs
# Lists actions for a document.
#
# This script requires either 2 program arguments or 2 environment variables to
# be set: "DOCUMENT_NAME" and "DOCUMENT_PATH". In the Alfred workflow these are
# exposed as variables by "list-documents".
#
# Additionally the script supports the environment variable "ACTIONS". It must
# contain a JSON object that defines all actions that can be performed on a
# document. If not provided, the script falls back on the DEFAULT_ACTIONS
# from the "defaults" script.
source ${0:a:h}/defaults
if (( # != 2 )); then
  if [[ ! -v DOCUMENT_NAME ]]; then
    print >&2 "Document name missing"
    exit 1
  fi
  if [[ ! -v DOCUMENT_PATH ]]; then
    print >&2 "Document path missing"
    exit 1
  fi
else
  DOCUMENT_NAME="$1"
  DOCUMENT_PATH="$2"
fi
init_active_curator
jq -n \
  --argjson actions "$ACTIONS" \
  --arg document_name "$DOCUMENT_NAME" \
  --arg document_path "$DOCUMENT_PATH" \
  '
def process_item(property_value):
  . as $item |
  if ($ENV.APPLICATION | length > 0)
    and ($item.application | select(. != null) | . == $ENV.APPLICATION)
  then
    empty
  else
    ($item.title // "") as $raw_title |
    ($item.url // "") as $raw_url |
    ($raw_title
      | gsub("NAME"; $document_name)
      | gsub("PATH"; $document_path)
      | (if property_value then gsub("PROPERTY"; property_value) else . end)
    ) as $title |
    ($raw_url
      | gsub("NAME"; $document_name | @uri)
      | gsub("PATH"; $document_path | @uri)
      | (if property_value then gsub("PROPERTY"; property_value | @uri) else . end)
    ) as $url |
    {
      title: $title,
      arg: (
        if ($url | length > 0) then
          $url
        elif $item.application then
          $document_path
        else
          ""
        end
      )
    }
    + (
      if $item.icon then
        {
          icon: {
            path: (
              if ($item.icon | startswith("/")) then
                $item.icon
              elif $item.application then
                "\($item.application)/Contents/Resources/\($item.icon)"
              else
                $item.icon
              end
            )
          }
        }
      else
        {}
      end
    )
    + {
      variables: {
        APPLICATION: ($item.application // ""),
        URL: ($url // "")
      }
    }
  end;

{
  items: [
    ($actions.document[]? | process_item(null)),
    (
      ($actions.environment // {}) |
      to_entries[]? |
      .key as $environment_variable | .value as $item |
      ($ENV[$environment_variable] // empty) as $property_value |
      select($property_value | length > 0) |
      ($item | process_item($property_value))
    )
  ]
}
'
